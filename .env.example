# ════════════════════════════════════════════════════════════════
#  Gauge Client — Local Environment Overrides
# ════════════════════════════════════════════════════════════════
#  These values override secrets from Vault and vault/.env.
#  Only add variables you want to change for local development.
#
#  To use:  cp .env.example .env
#
#  Resolution order (first wins):
#    1. process.env (manual env vars)
#    2. This file (.env)
#    3. Vault service
#    4. Shared vault/.env fallback
# ════════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────
# GAUGE_CLIENT_PORT="3006"

# ── Vault Connection ──────────────────────────────────────────
# VAULT_SERVICE_URL="http://<host>:5599"
# VAULT_SERVICE_TOKEN=""

# ── API (backend for this frontend) ───────────────────────────
# GAUGE_SERVICE_URL="http://localhost:5607"
# GAUGE_SERVICE_PUBLIC_URL=""

# ── Tools Service ─────────────────────────────────────────────
# TOOLS_SERVICE_URL="http://192.168.86.2:5590"

# ── Auth (Google SSO) ─────────────────────────────────────────
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_SECRET=""
# AUTH_ALLOWED_EMAILS=""
